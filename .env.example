# Copier en .env (cp .env.example .env) puis changer les mots de passe.
# .env n'est jamais commité.

# --- PostgreSQL (propriétaire de la base : sert uniquement à Flyway) ---
POSTGRES_DB=safetransport
POSTGRES_USER=safetransport_owner
POSTGRES_PASSWORD=change-me-owner
DB_PORT=5432

# --- Comptes de connexion des services (créés au premier démarrage du volume) ---
API_DB_USER=app_api
API_DB_PASSWORD=change-me-api
AI_DB_USER=app_ai
AI_DB_PASSWORD=change-me-ai
ADMIN_DB_USER=app_admin
ADMIN_DB_PASSWORD=change-me-admin
BI_DB_USER=app_bi
BI_DB_PASSWORD=change-me-bi

# --- Flyway : en dev on charge aussi le jeu de données SIMULÉ (db/seed). En prod : migrations seules. ---
FLYWAY_LOCATIONS=filesystem:/flyway/migrations,filesystem:/flyway/seed

# --- Ports exposés sur la machine ---
API_PORT=8080
AI_PORT=8000
ADMIN_PORT=8001
WEB_PORT=5173
NOTIFICATIONS_PORT=3000

# --- Laravel : facultatif en dev (sinon clé temporaire). Générer : cd admin && php artisan key:generate --show
ADMIN_APP_KEY=

# --- LLM / RAG (phase RAG) : laisser vide tant que non utilisé ---
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
